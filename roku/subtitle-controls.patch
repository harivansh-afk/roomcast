 ' Roomcast timestamp protocol. Does not restart or replace the current content.
+sub configureSubtitles(deeplink)
+    m.subtitleConfig = deeplink
+    if m.subtitleConfig.subtitlesEnabled = invalid
+        m.subtitleConfig.subtitlesEnabled = true
+    end if
+    m.lastSubtitleReport = ""
+    m.subtitlePending = true
+    m.subtitleReportSequence = 0
+    if m.subtitleReporter <> invalid
+        m.subtitleReporter.control = "STOP"
+    end if
+    applySubtitles()
+end sub
+
+sub applySubtitles()
+    if m.subtitleConfig = invalid or m.applyingSubtitles = true then return
+    if m.subtitlePending <> true
+        reportSubtitles()
+        return
+    end if
+    m.applyingSubtitles = true
+    if m.subtitleConfig.subtitlesEnabled
+        m.video.globalCaptionMode = "On"
+        for each item in m.video.availableSubtitleTracks
+            if (m.subtitleConfig.subtitleUrl <> "" and item.TrackName = m.subtitleConfig.subtitleUrl) or (m.subtitleConfig.subtitleName <> "" and item.Description = m.subtitleConfig.subtitleName)
+                if m.video.subtitleTrack <> item.TrackName
+                    m.video.subtitleTrack = item.TrackName
+                end if
+                exit for
+            end if
+        end for
+    else
+        m.video.globalCaptionMode = "Off"
+    end if
+    m.applyingSubtitles = false
+    reportSubtitles()
+end sub
+
+sub reportSubtitles()
+    if m.subtitleConfig = invalid or m.applyingSubtitles = true then return
+    if m.subtitleConfig.subtitleReportUrl = "" or m.subtitleConfig.subtitleRequest = "" then return
+    available = false
+    selected = false
+    for each item in m.video.availableSubtitleTracks
+        if (m.subtitleConfig.subtitleUrl <> "" and item.TrackName = m.subtitleConfig.subtitleUrl) or (m.subtitleConfig.subtitleName <> "" and item.Description = m.subtitleConfig.subtitleName)
+            available = true
+            selected = (m.video.currentSubtitleTrack = item.TrackName)
+            exit for
+        end if
+    end for
+    if m.subtitleConfig.subtitlesEnabled
+        applied = selected and m.video.globalCaptionMode = "On"
+        ' Wait for the player to expose and select a track during startup.
+        if not applied and m.lastSubtitleReport = "" then return
+    else
+        applied = (m.video.globalCaptionMode = "Off")
+    end if
+    if applied then m.subtitlePending = false
+    report = {
+        request: m.subtitleConfig.subtitleRequest
+        enabled: m.subtitleConfig.subtitlesEnabled
+        track: m.subtitleConfig.subtitleId
+        available: available
+        applied: applied
+        caption_mode: m.video.globalCaptionMode
+    }
+    signature = FormatJson(report)
+    if signature = m.lastSubtitleReport then return
+    m.lastSubtitleReport = signature
+    m.subtitleReportSequence++
+    report.sequence = m.subtitleReportSequence
+    m.subtitleReporter = CreateObject("roSGNode", "subtitleReport")
+    m.subtitleReporter.url = m.subtitleConfig.subtitleReportUrl
+    m.subtitleReporter.report = report
+    m.subtitleReporter.control = "RUN"
+end sub
+
