+' Roomcast timestamp protocol. Does not restart or replace the current content.
+sub seekVideo(deeplink)
+    if m.parsedDeeplink = invalid then return
+    if m.parsedDeeplink.t <> "v" then return
+    if m.video.state <> "playing" and m.video.state <> "paused" then return
+    target = deeplink.positionSeconds
+    if target = invalid then return
+    if target < 0 or target >= m.video.duration then return
+    m.video.autoplayAfterSeek = (deeplink.stayPaused <> true)
+    m.video.seek = target
+end sub
